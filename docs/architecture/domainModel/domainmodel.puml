' -----------------------------------------------------------------------------
' ALLERGEN AGGREGATE.
' -----------------------------------------------------------------------------
package "Allergen Aggregate" <<Rectangle>> {

    class Allergen <<entity>> <<aggregateRoot>> {
    }

    class AllergenId <<vo>> {
        + value : int
    }

    note right of AllergenId
        - AllergenId is a unique identifier for an allergen.
        - Must be an integer between 1 and 14 (inclusive),
          corresponding to the official EU Regulation No. 1169/2011.
    end note

    enum EUAllergenType <<enum>> {
        1 : GLUTEN
        2 : CRUSTACEANS
        3 : EGGS
        4 : FISH
        5 : PEANUTS
        6 : SOYBEANS
        7 : MILK
        8 : NUTS
        9 : CELERY
        10 : MUSTARD
        11 : SESAME
        12 : SULPHITES
        13 : LUPIN
        14 : MOLLUSCS
    }

    AllergenId ..> EUAllergenType : bounded by >

    class AllergenName <<vo>> {
        + name : String
    }

    Allergen "1" *-- "1" AllergenId
    Allergen "1" *-- "1" AllergenName

    note right of Allergen
        An Allergen represents a food
        allergen that may be associated
        with Products and DietaryRestrictions.
    end note
}

' -----------------------------------------------------------------------------
' PIZZA SIZE AGGREGATE.
' -----------------------------------------------------------------------------
package "Pizza Size Aggregate" <<Rectangle>> {

    class PizzaSize <<entity>> <<aggregateRoot>> {
        + isActive : boolean
    }

    class PizzaSizeId <<vo>> {
        + id : string
    }

    class PizzaSizeName <<vo>> {
        + name : string
    }

    PizzaSize "1" *-- "1" PizzaSizeId : identified by >
    PizzaSize "1" *-- "1" PizzaSizeName : named >
}

' -----------------------------------------------------------------------------
' PIZZA COMPONENT TYPE AGGREGATE.
' -----------------------------------------------------------------------------
package "Pizza Component Type Aggregate" <<Rectangle>> {

    class PizzaComponentType <<entity>> <<aggregateRoot>> {
        + assemblyOrder : int
        + minQuantity : int
        + maxQuantity : Integer
    }

    class ComponentTypeId <<vo>> {
        + value : string
    }

    note right of ComponentTypeId
        - ComponentTypeId is a unique identifier for a pizza component type.
        - Must be a string representing the component type ID.
        - Example: "COMP-00123".
    end note

    class ComponentTypeName <<vo>> {
        + name : String
    }

    PizzaComponentType "1" *-- "1" ComponentTypeId
    PizzaComponentType "1" *-- "1" ComponentTypeName

    note right of PizzaComponentType
    Business rules:
        - minQuantity >= 0
        - maxQuantity >= minQuantity
        - assemblyOrder determines
          the component type order
          during pizza assembly.
    end note
}

' -----------------------------------------------------------------------------
' COMPONENT SIZE CONFIGURATION AGGREGATE.
' -----------------------------------------------------------------------------
package "Component Size Configuration Aggregate" <<Rectangle>> {

    class ComponentSizeConfiguration <<entity>> <<aggregateRoot>> {
    }

    class Money <<vo>> {
        + amount : BigDecimal
        + currency : String
    }

    class StockUnitsConsumed <<vo>> {
        + quantity : int
    }

    ComponentSizeConfiguration "1" *-- "1" Money : price >
    ComponentSizeConfiguration "1" *-- "1" StockUnitsConsumed : consumes >

    note right of ComponentSizeConfiguration
    Business rules:
        - A Product used in a pizza composition has a size-specific configuration. The configuration defines both price and consumed stock units per size.
        - A Product + Pizza Size pair identifies at most one configuration.
        - Stock consumption is derived from the recursively expanded composition and configured quantities.
    end note
}

' -----------------------------------------------------------------------------
' INVENTORY (STOCK) AGGREGATE.
' -----------------------------------------------------------------------------
package "Stock Aggregate" <<Rectangle>> {

    class StockInformation <<entity>> <<aggregateRoot>> {
    }

    class StockId <<vo>> {
        + value : string
    }

    note right of StockId
        - StockId is a unique identifier for a stock item.
        - Must be a string representing the stock ID.
        - Example: "STOCK-00123".
    end note

    class AbstractStockQuantity <<vo>> {
        + availableUnits : int
    }


    StockInformation "1" *-- "1" StockId
    StockInformation "1" *-- "1" AbstractStockQuantity : maintains >

    note right of StockInformation
    Business rules:
        - Each StockInformation represents one period
          in which stock control is enabled for a Product.
        - availableUnits is a non-negative integer; an
          adjustment that would make it negative is rejected.
        - A zero quantity makes the Product out of stock, but
          does not deactivate it or remove stock control.
        - Stock is consumed when an order is confirmed.
        - StockInformation preserves period snapshots; a
          movement-by-movement history is not required here.
    end note
}

' -----------------------------------------------------------------------------
' ORDER AGGREGATE.
' -----------------------------------------------------------------------------
package "Order Aggregate" <<Rectangle>> {

    class Order <<entity>> <<aggregateRoot>> {
        + placedAt : DateTime
    }

    class OrderId <<vo>> {
        + value : string
    }

    note right of OrderId
        - OrderId is a unique identifier for an order.
        - Must be a string representing the order ID.
        - Example: "ORDER-00123".
    end note

    enum OrderStatus <<enum>> {
        DRAFT_SIMULATED
        CONFIRMED
        IN_PREPARATION
        READY
        SERVED
        CANCELLED
    }

    class OrderItem <<entity>> {
        + quantity : int
    }

    class OrderItemId <<vo>> {
        + value : string
    }

    class "Money" as OrderItemMoney <<vo>> {
        + amount : BigDecimal
        + currency : String
    }

    enum OrderItemStatus <<enum>> {
        PENDING
        PREPARING
        READY
        SERVED
    }

    class PersonalizedPizzaConfiguration <<vo>> {
        + sizeId : string
        + selectedComponentIds : List<string>
    }

    Order "1" *-- "1" OrderId : identified by >
    Order "1" --> "1" OrderStatus : current status >
    Order "1" *-- "1..*" OrderItem : contains >

    OrderItem "1" *-- "1" OrderItemId
    OrderItem "1" --> "1" OrderItemStatus : status >
    OrderItem "1" *-- "1" OrderItemMoney : unitPrice >
    OrderItem "1" *-- "0..1" PersonalizedPizzaConfiguration : preserves configuration >

    note right of OrderItem
    Business rules:
        - An item represents either a
          catalogue product or a preserved
          personalized pizza configuration.
        - Quantity must be positive.
        - Unit price is preserved when
          the order is confirmed.
        - For pizzas, unit price is calculated
          from the selected components and size.
        - Subtotal is derived from
          quantity * unitPrice.
    end note
}

' -----------------------------------------------------------------------------
' PREPARATION ACTIVITY AGGREGATE.
' -----------------------------------------------------------------------------
package "Preparation Activity Aggregate" <<Rectangle>> {

    class PreparationActivity <<entity>> <<aggregateRoot>> {
        + estimatedDurationMinutes : int
    }

    class ActivityId <<vo>> {
        + value : string
    }
    note right of ActivityId
        - ActivityId is a unique identifier for a preparation activity.
        - Must be a string representing the activity ID.
        - Example: "ACT-00123".
    end note

    enum ActivityType <<enum>> {
        ASSEMBLY
        BAKING
    }

    enum ExecutionState <<enum>> {
        WAITING
        SCHEDULED
        IN_EXECUTION
        COMPLETED
    }

    PreparationActivity "1" *-- "1" ActivityId
    PreparationActivity "1" --> "1" ActivityType : typed as >
    PreparationActivity "1" --> "1" ExecutionState : status >
}

' -----------------------------------------------------------------------------
' KITCHEN RESOURCE AGGREGATE.
' -----------------------------------------------------------------------------
package "Kitchen Resource Aggregate" <<Rectangle>> {

    class KitchenResource <<entity>> <<aggregateRoot>> {
        + capacity : int
    }

    class ResourceId <<vo>> {
        + value : string
    }

    note right of ResourceId
        - ResourceId is a unique identifier for a kitchen resource.
        - Must be a string representing the resource ID.
        - Example: "RES-00123".
    end note

    class ResourceName <<vo>> {
        + name : String
    }

    enum ResourceType <<enum>> {
        PREPARATION_STATION
        OVEN
    }

    enum ResourceStatus <<enum>> {
        AVAILABLE
        BUSY
        MAINTENANCE
    }

    KitchenResource "1" *-- "1" ResourceId
    KitchenResource "1" *-- "1" ResourceName
    KitchenResource "1" --> "1" ResourceType : typed as >
    KitchenResource "1" --> "1" ResourceStatus : current status >

    note right of KitchenResource
        Business rules:
        - capacity > 0
        - Resource must have a type.
        - Resource availability affects
          preparation scheduling.
    end note
}

' -----------------------------------------------------------------------------
' FOOD PREPARATION SCHEDULE AGGREGATE.
' -----------------------------------------------------------------------------
package "Food Preparation Schedule Aggregate" <<Rectangle>> {

    class FoodPreparationSchedule <<entity>> <<aggregateRoot>> {
        + generatedAt : DateTime
    }

    class ScheduleId <<vo>> {
        + value : string
    }

    note right of ScheduleId
        - ScheduleId is a unique identifier for a food preparation schedule.
        - Must be a string representing the schedule ID.
        - Example: "SCHED-00123".
    end note

    class ScheduledSlot <<vo>> {
        + startTime : DateTime
        + endTime : DateTime
    }

    FoodPreparationSchedule "1" *-- "1" ScheduleId
    FoodPreparationSchedule "1" *-- "1..*" ScheduledSlot : composed of >
}

' -----------------------------------------------------------------------------
' CROSS-AGGREGATE LINKS.
' -----------------------------------------------------------------------------

Customer "0..1" --> "0..1" User : may be associated with >

DietaryRestriction --> Allergen : relates to >

Product "0..*" --> "1" ProductCategory : categorized by >
Product "0..*" --> "0..*" Allergen : contains >
PizzaComponent "0..*" --> "1" PizzaComponentType : classified by >

ComponentSizeConfiguration "0..*" --> "1" PizzaComponent : applies to component >
ComponentSizeConfiguration "0..*" --> "1" PizzaSize : for size >

StockInformation "0..*" --> "1" Product : tracks stock periods for >

Order "0..*" --> "0..1" Customer : placed by >
OrderItem "0..*" --> "0..1" Product : references catalogue >

PreparationActivity "0..*" --> "1" OrderItem : generated for >

PreparationActivity --> KitchenResource : requires >

FoodPreparationSchedule --> PreparationActivity : schedules >
FoodPreparationSchedule --> KitchenResource : allocates >

Order ..> StockInformation : consumes stock on confirmation >

@enduml
