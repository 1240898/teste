@startuml class_diagram_planning_inputs
title AI06 - HTTP input loading and request-local knowledge base
hide empty members
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

class "planning_inputs.pl" as Adapter <<Prolog module>> {
  load_inputs(Execution, Outcome)
  load_inputs(Execution, ServiceConfig, Outcome)
}
class "input_http.pl" as Http <<Prolog module>> {
  authorised HTTP reads
  bounded responses, timeout and no redirects
}
class "input_mapper.pl" as Mapper <<Prolog module>> {
  resolve size-specific BOMs and multiplicity
  map_document(Document, Execution, SnapshotId, Input)
  exact EUR cents and stable offer ordering
}
class "input_validation.pl" as Validation <<Prolog module>>
class "json_boundary.pl" as Json <<Prolog module>> {
  validate_json_numbers(Document)
  write_planning_json(Stream, Response)
}
class "Execution selectors" as Selection {
  executionId, scenarioId, calculation, mode, attemptNo
  demand, catalogue and stock source references
  supplier scenario and reference date for AI02
  replayedFrom for history
}
interface "Backoffice source API" as Sources {
  open coherent read view
  read selected products, sizes and configurations
  read selected recipes, stock and pending deliveries
  read confirmed supplier version
  close view
}
interface "Input records API" as Records {
  read retained inputs
  seal once with input attempt lease
}
class "Retained JSON input document" as Snapshot {
  schemaVersion and selected source references
  raw selected groups and provenance
}
class "planning_input" as KB <<ground SWI-Prolog dict>> {
  meta and eligibility
  pizza_demand : pizza_demand/3 list
  pizza_boms : bom/4 with component/2
  items : item/6 list
  recipes : recipe/3 with ingredient/2
  opening_stock : stock/2 list
  pending_receipts : pending_receipt/4 list
  direct_sale_demand : direct_sale/3 list
  offers : offer/7 list
  forecast : forecast/4 or none
  reference_date : date/3 or none
}
class "Input diagnostic" as Error {
  code, field, reference
  executionId and scenarioId
}
Adapter ..> Selection : accepts selectors only
Adapter ..> Http : calls
Http ..> Sources : reads with service credential
Http ..> Records : reads or seals with separate permission
Http ..> Json : validates transport numbers
Adapter ..> Mapper : maps retained winner
Mapper ..> Validation : validates
Mapper ..> Snapshot : consumes
Mapper ..> KB : builds
Records ..> Snapshot : retains in Backoffice PostgreSQL
Adapter ..> KB : returns ok(Input)
Adapter ..> Error : returns error(Diagnostic)
@enduml
