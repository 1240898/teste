@startuml sequence_diagram_load_planning_inputs
title AI06 - Prolog obtains business data through HTTP
autonumber
hide footbox
skinparam shadowing false
participant "Portal Backoffice" as Portal
participant "AI05 caller" as AI05
participant "planning_inputs.pl" as AI06
participant "Backoffice source API" as Sources
participant "Input records adapter" as Records
database "PostgreSQL" as DB

note over Portal,AI05 : Current Manager/session and record-access checks belong to the caller.
Portal -> Records : Register fixed selection / claim input lease
Records --> Portal : attemptNo and server expiry
Portal -> AI05 : Invoke Prolog with selectors and scheduling context
AI05 -> AI06 : load_inputs(Execution, Outcome)
AI06 -> Records : GET input-runs/{executionId}/inputs
alt 200 Retained current or historical inputs
  Records --> AI06 : Stored document, selection and snapshot ID
  AI06 -> AI06 : Check selection and schema
else 409 INPUTS_NOT_SEALED for the current attempt
  Records --> AI06 : Current input lease
  AI06 -> Sources : POST read-views (selectors)
  opt Current catalogue, stock or receipt source selected
    Sources -> DB : BEGIN REPEATABLE READ READ ONLY; pin snapshot
  end
  Sources --> AI06 : View ID, revision, demand and provenance
  loop Selected products, sizes, configurations, recipes, stock and AI02 pending deliveries
    AI06 -> Sources : POST read-views/{id}/{group} (selected IDs)
    Sources -> DB : Raw selected reads on the same connection, when current
    Sources --> AI06 : Records with same view ID and revision
    AI06 -> AI06 : Resolve components and follow produced recipes
  end
  opt AI02 input
    AI06 -> Sources : Read selected products' offers from confirmed version
    Sources --> AI06 : Exact version, offers and provenance
  end
  AI06 -> Sources : DELETE read-views/{id} (also on failure)
  Sources -> DB : ROLLBACK and release transient read connection
  AI06 -> AI06 : Validate candidate and map to Prolog
  alt Valid complete candidate
    AI06 -> Records : PUT inputs (attemptNo, validated raw document)
    Records -> DB : Lock input run; check lease and seal first candidate
    alt Current lease and no previous binding
      DB --> Records : New retained snapshot
    else Concurrent load already sealed inputs
      DB --> Records : Previously retained winner
    else Stale lease or storage failure
      DB --> Records : 409 STALE_ATTEMPT or 503
    end
    Records --> AI06 : Winner or diagnostic
  else Invalid or incomplete source data
    AI06 -> AI06 : Return diagnostic without retaining partial data
  end
else Other lookup or access failure
  Records --> AI06 : 401, 403, 404, 409, 422 or 503
  AI06 -> AI06 : Stop; no fallback to current data
end
alt Retained snapshot available
  AI06 -> AI06 : Build planning_input from stored winner
  AI06 --> AI05 : ok(Input) for AI01 or AI02
else Error
  AI06 --> AI05 : error(Diagnostic with execution context)
end
@enduml
