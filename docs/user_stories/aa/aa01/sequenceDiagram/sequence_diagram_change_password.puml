@startuml sequence_diagram_change_password
title SD 4 - Authenticated password change
hide footbox
skinparam shadowing false

actor "Signed-in user" as User
box "SPA" #F3F7FD
  participant ChangePasswordPage as Page
  participant authApi as Client
end box
box "Backend" #F5F8F5
  participant AuthRoutes as Routes
  participant AuthMiddleware as Auth
  participant AuthController as Controller
  participant UserService as Service
  participant UserRepository as Repo
  participant BcryptPasswordHasher as Hasher
end box

User -> Page : submit current and new passwords
Page -> Client : changePassword(accessToken, current, new)
Client -> Routes : PATCH /api/v1/auth/password
Routes -> Auth : verifyToken(req, res, next)
Auth --> Routes : authenticated actor, 401 or 403
alt Invalid authentication, denied access or malformed request
  Routes --> Client : 401, 403 or 400
else Authenticated and well-formed
  Routes -> Controller : changePassword(req, res)
  Controller -> Service : changePassword(actor, ChangePasswordDTO)
  Service -> Service : validate new password format
  Service -> Repo : findById(actor.sub)
  Repo --> Service : account and current credential
  opt Account is active and has a local password
    Service -> Hasher : compare submitted passwords with current hash
    Hasher --> Service : comparison results
    Service -> Service : validate password difference
  end
  alt Invalid account, credential or new password
    Service --> Controller : 401 or 422
    Controller --> Client : error response
  else Password change allowed
    Service -> Hasher : hash new password
    Hasher --> Service : replacement hash
    Service -> Repo : updatePasswordIfCurrent(id, currentHash, replacementHash)
    Repo --> Service : updated or account changed concurrently
    Service --> Controller : success or 409
    Controller --> Client : 204 No Content or 409
  end
end
Client --> Page : show result

note over Repo
  The conditional update requires the current hash and an active account.
end note
@enduml
