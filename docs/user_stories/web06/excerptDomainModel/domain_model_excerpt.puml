@startuml LaPrizzaDomainModel
skinparam packageStyle rectangle
skinparam shadowing true
skinparam classAttributeIconSize 0
hide methods

title Domain Model Excerpt - WEB06 Kitchen Configuration and 3D Integration Page

' -----------------------------------------------------------------------------
' KITCHEN CONFIGURATION AGGREGATE (introduced by WEB06, persisted in PostgreSQL, content as JSONB)
' -----------------------------------------------------------------------------
package "Kitchen Configuration Aggregate" <<Rectangle>> {

    class KitchenConfiguration <<entity>> <<aggregateRoot>> {
        + version : Integer
        + createdAt : DateTime
        + updatedAt : DateTime
        + activatedAt : DateTime [0..1]
    }
    note right of KitchenConfiguration
        Created, imported, edited, deleted and
        activated only by a LaPrizza Manager.
        - New / imported configurations are INACTIVE.
        - The ACTIVE one cannot be deleted.
        - version changes on every accepted edit
          (optimistic concurrency, client clarification 15).
        - Content is replaced only by a VALID layout:
          an invalid edit leaves the last valid one.
    end note

    class KitchenConfigurationId <<vo>> {
        + value : String
    }
    note right of KitchenConfigurationId
        - Generated by the back end, immutable.
        - Format: "KCF-" + 5+ digits.
        - Example: "KCF-00001".
    end note

    class ConfigurationName <<vo>> {
        + value : String
    }
    note right of ConfigurationName
        - 3 to 80 characters (trimmed).
        - Unique, case-insensitive.
    end note

    enum ConfigurationStatus <<enum>> {
        ACTIVE
        INACTIVE
    }
    note right of ConfigurationStatus
        At most ONE configuration is ACTIVE at any time;
        once one has been activated, exactly one stays
        ACTIVE (it can only be replaced by activating
        another one, in a single transaction).
    end note

    class KitchenLayout <<vo>> {
    }
    note left of KitchenLayout
        The JSON content of the configuration,
        validated and replaced as a whole.
        Distances in metres, angles in degrees;
        Y-up; origin at the centre of the floor.
        Contains at least one EQUIPMENT element
        and exactly one assembly line (VIS03).
        Floor and walls have a texture set (VIS04).
    end note

    class KitchenDimensions <<vo>> {
        + width : Decimal
        + depth : Decimal
        + height : Decimal
    }
    note bottom of KitchenDimensions
        Metres.
        width, depth: 2..100
        height: 2..10
    end note

    class AssemblyLine <<vo>> {
        + wall : KitchenWall
    }
    note right of AssemblyLine
        VIS03 - on ONE kitchen wall:
        - exactly one ASSEMBLY_COUNTER, RECEIVING_PLATFORM,
          DISPENSER (overhead crusts), CONVEYOR_BELT and
          WOOD_FIRED_OVEN; at least three ROBOTIC_ARMs;
        - every line element within 1.5 m of the wall;
        - facing the wall, left to right: platform, arms,
          oven; the belt between platform and oven; the
          dispenser above the platform.
        Dispenser, belt and arms are animated in Sprint 3.
    end note

    enum KitchenWall <<enum>> {
        NORTH
        SOUTH
        EAST
        WEST
    }

    class SceneElement <<entity>> {
        + elementId : String
        + name : String [0..1]
    }
    note right of SceneElement
        elementId unique inside the layout
        (^[A-Za-z0-9_-]{1,64}$).
    end note

    enum ElementCategory <<enum>> {
        EQUIPMENT
        ASSEMBLY_LINE
    }

    class ElementType <<vo>> {
        + value : String
    }
    note bottom of ElementType
        EQUIPMENT: TABLE, COUNTER, WOOD_FIRED_OVEN,
        DEEP_FRYER, GRIDDLE, GRILL, REFRIGERATOR,
        DISHWASHER, EXHAUST_HOOD, COOKING_TOOL (VIS02)
        ASSEMBLY_LINE: ASSEMBLY_COUNTER,
        RECEIVING_PLATFORM, CRUST_FEEDER, CONVEYOR_BELT,
        DISPENSER, ROBOTIC_ARM, WOOD_FIRED_OVEN (VIS03)
    end note

    class Placement <<vo>> {
        + position : Vector3
        + rotation : Vector3
        + scale : Vector3
    }
    note bottom of Placement
        position inside the kitchen bounds;
        rotation in degrees [-360, 360];
        scale components 0.01..100.
    end note

    abstract class ModelReference <<vo>> {
        + source : "ASSET" | "PROCEDURAL"
    }

    class AssetModelReference <<vo>> {
        + assetId : KitchenAssetId
    }

    class ProceduralModelReference <<vo>> {
        + shape : "BOX" | "CYLINDER" | "SPHERE" | "DOME"
        + size : Vector3
    }

    class MaterialProperties <<vo>> {
        + color 
        + roughness 
        + metalness 
        + colorMapAssetId 
        + roughnessMapAssetId 
        + normalMapAssetId 
        + bumpMapAssetId 
    }
        note bottom of MaterialProperties
        Visual properties for VIS04.
        Texture set = colour map AND at least one
        roughness, normal or bump map (a partial set
        is rejected in both directions).
        Mandatory for procedural objects; optional
        override for imported models.
        end note

    KitchenConfiguration "1" *-- "1" KitchenConfigurationId : identified by >
    KitchenConfiguration "1" *-- "1" ConfigurationName : has >
    KitchenConfiguration "1" --> "1" ConfigurationStatus : current status >
    KitchenConfiguration "1" *-- "1" KitchenLayout : content >
    KitchenLayout "1" *-- "1" KitchenDimensions : has >
    KitchenLayout "1" *-- "1" AssemblyLine : has >
    AssemblyLine "1" --> "1" KitchenWall : placed on >
    KitchenLayout "1" *-- "2..300" SceneElement : contains >
    SceneElement "1" --> "1" ElementCategory : belongs to >
    SceneElement "1" *-- "1" ElementType : is of >
    SceneElement "1" *-- "1" Placement : placed with >
    SceneElement "1" *-- "1" ModelReference : represented by >
    SceneElement "1" *-- "0..1" MaterialProperties : rendered with >
    ModelReference <|-- AssetModelReference
    ModelReference <|-- ProceduralModelReference
}

' -----------------------------------------------------------------------------
' KITCHEN ASSET CATALOGUE (read-only reference data used by WEB06 validation
' and resolved for the viewer - files supplied by VIS02 / VIS03 / VIS04)
' -----------------------------------------------------------------------------
package "Kitchen Asset Aggregate" <<Rectangle>> {

    class KitchenAsset <<entity>> <<aggregateRoot>> {
        + format : String
        + path : String
        + description : String
        + size : Vector3 [0..1]
        + embeddedTextureSet : boolean [0..1]
    }
    note left of KitchenAsset
        MODEL only (glTF / GLB), computed from the
        file when the catalogue is seeded:
        - size: bounding box at scale 1 (metres),
          used for the belt connection (VIS03)
        - embeddedTextureSet: every material has a
          colour map + roughness / normal map (VIS04);
          if false, elements using the model need a
          material override with a texture set
    end note
    note right of KitchenAsset
        Read-only in Sprint 2 (seeded from a
        versioned manifest). A configuration
        refers to an asset ONLY by its id; the
        back end resolves the URL (VIS02 / VIS04:
        "URLs retrieved from the back end").
    end note

    class KitchenAssetId <<vo>> {
        + value : String
    }
    note right of KitchenAssetId
        Example: "AST-MDL-OVEN-01".
    end note

    enum AssetKind <<enum>> {
        MODEL
        TEXTURE
    }

    KitchenAsset "1" *-- "1" KitchenAssetId : identified by >
    KitchenAsset "1" --> "1" AssetKind : is a >
}

' -----------------------------------------------------------------------------
' USER AGGREGATE (existing, AA03) - only the part that decides access
' -----------------------------------------------------------------------------
package "User Aggregate" <<Rectangle>> {

    class User <<entity>> <<aggregateRoot>> {
        + active : boolean
    }

    enum UserRole <<enum>> {
        ADMINISTRATOR
        MANAGER
        EMPLOYEE
        CUSTOMER
    }
    note right of UserRole
        Table 1:
        - MANAGER: manages and activates
          kitchen JSON configurations
        - EMPLOYEE: only consults the viewer
          (reads the ACTIVE configuration)
        - CUSTOMER, ADMINISTRATOR (alone),
          Guest: no access
    end note

    User "1" --> "1..*" UserRole : assigned >
}

AssetModelReference ..> KitchenAsset : refers to (kind = MODEL) >
MaterialProperties ..> KitchenAsset : refers to (kind = TEXTURE) >
User "1" -- "0..*" KitchenConfiguration : manages / activates\n(MANAGER) >
User ..> KitchenConfiguration : consults ACTIVE\n(MANAGER / EMPLOYEE) >

@enduml
