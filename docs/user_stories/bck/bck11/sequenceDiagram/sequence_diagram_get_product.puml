@startuml sequence_diagram_get_product
autonumber
skinparam maxMessageSize 105
skinparam shadowing true
skinparam responseMessageBelowArrow true
title BCK11 - Consult individual sellable product
actor Customer
participant Routes as "CatalogueRoutes"
participant Auth as "AuthMiddleware"
participant Roles as "RoleMiddleware"
participant Controller as "CatalogueController"
participant ProductId as "ProductId"
participant Service as "CatalogueService"
participant Reader as "reader : ICatalogueReader"
participant PersistenceMapper as "CataloguePersistenceMapper"
database DB as "PostgreSQL"
participant Facts as "CatalogueFacts"
participant Policy as "CataloguePolicy"
participant Product as "Product"
participant Mapper as "CatalogueResponseMapper"
participant Errors as "errorHandler"

Customer -> Routes : GET /api/v1/catalogue/{productId}
activate Routes
opt approved policy requires authentication
 Routes -> Auth : verifyToken(req, res, next)
 activate Auth
 break missing / invalid credentials
  Auth -> Errors : errorHandler(AppError(401), req, res, next)
  Errors --> Customer : 401 standard JSON error
 end
 Auth --> Routes : next(); req.user established
 deactivate Auth
end
opt approved policy additionally restricts roles
 Routes -> Roles : requireRole(...approvedRoles)(req, res, next)
 activate Roles
 break authenticated role not permitted
  Roles -> Errors : errorHandler(AppError(403), req, res, next)
  Errors --> Customer : 403 standard JSON error
 end
 Roles --> Routes : next()
 deactivate Roles
end
Routes -> Controller : getById(req, res, next)
activate Controller
Controller -> ProductId : create(req.params.productId)
activate ProductId
break invalid identifier
 ProductId --> Controller : throws existing AppError(400)
 Controller -> Errors : errorHandler(AppError(400), req, res, next)
 Errors --> Customer : 400 standard JSON error
end
ProductId --> Controller : productId
deactivate ProductId
Controller -> Service : getById(productId)
activate Service
Service -> Reader : loadFor(productId)
activate Reader
Reader -> DB : query(parameterized SQL: target Product + related facts; CURRENT stock only)
activate DB
break SQL / connection failure
 DB --> Reader : error
 Reader --> Service : rejected promise
 Service --> Controller : error
 Controller -> Errors : errorHandler(error, req, res, next)
 Errors --> Customer : 500 generic JSON error
end
DB --> Reader : rows for sellable root and dependency closure
deactivate DB
Reader -> PersistenceMapper : toFacts(rows)
activate PersistenceMapper
break mapping / persisted invariant failure
 PersistenceMapper --> Reader : error
 Reader --> Service : rejected promise
 Service --> Controller : error
 Controller -> Errors : errorHandler(error, req, res, next)
 Errors --> Customer : 500 generic JSON error
end
PersistenceMapper --> Reader : CatalogueFacts
deactivate PersistenceMapper
Reader --> Service : facts
deactivate Reader
Service -> Facts : getRoots()
activate Facts
Facts --> Service : Product[] (empty if absent or non-sellable)
deactivate Facts
break no sellable Product found
 Service --> Controller : CatalogueNotFoundError
 Controller -> Controller : toHttpError(error)
 Controller -> Errors : errorHandler(AppError(404), req, res, next)
 Errors --> Customer : 404 standard JSON error
end
Service -> Policy : evaluate(product, facts)
activate Policy
Policy -> Product : isSellable()
activate Product
Product --> Policy : sellable : boolean
deactivate Product
break defensive non-sellable result
 Policy --> Service : null
 Service --> Controller : CatalogueNotFoundError
 Controller -> Controller : toHttpError(error)
 Controller -> Errors : errorHandler(AppError(404), req, res, next)
 Errors --> Customer : 404 standard JSON error
end
note over Policy
 Use the same evaluation rules as catalogue listing:
 resolve category/allergen names from Product IDs;
 FIXED uses basePrice; COMPONENT_BASED requires PredefinedPizza;
 normalize BCK08 component prices to BCK05 Money and sum per size;
 use CURRENT stock only and evaluate each size independently.
 Inactive sellable Products and configured inactive sizes remain visible,
 marked available=false. Zero ordinary stock also means unavailable.
end note
Policy --> Service : CatalogueEntry
deactivate Policy
Service -> Mapper : toDTO(entry)
activate Mapper
Mapper --> Service : CatalogueProductDTO
deactivate Mapper
Service --> Controller : dto
deactivate Service
Controller --> Customer : 200 OK\nCatalogueProductDTO
deactivate Controller
deactivate Routes
@enduml
