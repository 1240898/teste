@startuml class_diagram
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing true
skinparam linetype ortho
left to right direction
title BCK11 - Product Catalogue and Product Information 

package "Presentation Layer (API)" as API {
 class CatalogueRoutes {
  - controller: CatalogueController
  + setupRoutes(accessHandlers: Middleware[]): Router
 }
 class CatalogueController <<controller>> {
  - service: CatalogueService
  + list(req, res, next): Promise<void>
  + getById(req, res, next): Promise<void>
  - toHttpError(error: Error): Error
 }
 class "errorHandler" as ErrorHandler <<function>> {
  + errorHandler(err, req, res, next): void
 }
 class AuthMiddleware <<middleware>> {
  + verifyToken(req, res, next): Promise<void>
 }
 class RoleMiddleware <<middleware>> {
  {static} + requireRole(...roles: string[]): Middleware
 }
}
package "Shared Error Contract" as SHARED {
 class AppError <<exception>> {
  + status: int
  + message: string
  + constructor(message: string, status: int)
 }
}
package "Application Layer" as APP {
 class CatalogueService <<service>> {
  - reader: ICatalogueReader
  - policy: CataloguePolicy
  - mapper: CatalogueResponseMapper
  + list(): Promise<CatalogueProductDTO[]>
  + getById(productId: ProductId): Promise<CatalogueProductDTO>
 }
 interface ICatalogueReader <<port>> {
  + loadSellable(): Promise<CatalogueFacts>
  + loadFor(productId: ProductId): Promise<CatalogueFacts>
 }
 class CatalogueNotFoundError <<exception>>
 class CatalogueResponseMapper <<mapper>> {
  + toDTO(entry: CatalogueEntry): CatalogueProductDTO
 }
 class CatalogueProductDTO <<dto>> {
  + id: string
  + name: string
  + description: string
  + available: boolean
  + category: CategoryDTO
  + price: MoneyDTO | null
  + allergens: AllergenDTO[]
  + pizza: PizzaDTO | null
 }
 class CategoryDTO <<dto>> {
  + id: string
  + name: string
 }
 class AllergenDTO <<dto>> {
  + id: int
  + name: string
 }
 class MoneyDTO <<dto>> {
  + amount: string
  + currency: string
 }
 class PizzaDTO <<dto>> {
  + defaultComponents: ComponentDTO[]
  + sizes: PizzaSizeDTO[]
 }
 class ComponentDTO <<dto>> {
  + id: string
  + name: string
  + pizzaComponentTypeId: string
 }
 class PizzaSizeDTO <<dto>> {
  + sizeId: string
  + sizeName: string
  + price: MoneyDTO
  + available: boolean
 }
}
package "Domain Layer" as DOMAIN {
 class CataloguePolicy <<domain service>> {
  + evaluate(product: Product, facts: CatalogueFacts): CatalogueEntry | null
  - evaluatePizza(product: Product, pizza: PredefinedPizza, facts: CatalogueFacts): CatalogueEntry
  - evaluateSize(components: Product[], size: PizzaSize, facts: CatalogueFacts): PizzaSizeOffer | null
 }
 class CatalogueFacts <<snapshot>> {
  - roots: Product[]
  - products: Map<string, Product>
  - categories: Map<string, ProductCategory>
  - allergens: Map<int, Allergen>
  - pizzas: Map<string, PredefinedPizza>
  - configurations: ComponentSizeConfiguration[]
  - currentStock: Map<string, StockInformation>
  - sizes: PizzaSize[]
  + getRoots(): Product[]
  + getPizza(productId: ProductId): PredefinedPizza | null
  + resolveComponents(configuration: PizzaConfiguration): Product[]
  + getCategory(categoryId: CategoryId): ProductCategory | null
  + getAllergens(allergenIds: AllergenId[]): Allergen[]
  + getSizes(): PizzaSize[]
  + getConfiguration(productId: ProductId, size: PizzaSizeId): ComponentSizeConfiguration | null
  + getCurrentStock(productId: ProductId): StockInformation | null
 }
 class CatalogueEntry <<vo>> {
  + product: Product {readOnly}
  + available: boolean {readOnly}
  + category: ProductCategory {readOnly}
  + allergens: Allergen[] {readOnly}
  + components: Product[] {readOnly}
  + sizes: PizzaSizeOffer[] {readOnly}
  + isPizza: boolean {readOnly}
 }
 class PizzaSizeOffer <<vo>> {
  + sizeId: PizzaSizeId {readOnly}
  + sizeName: string {readOnly}
  + price: Money {readOnly}
  + available: boolean {readOnly}
 }
 class InvalidCatalogueData <<exception>>
 package "Related domains" {
  class Product <<entity>> <<aggregateRoot>> {
   - id: ProductId
   - name: ProductName
   - description: ProductDescription
   - categoryId: CategoryId
   - isSellable: boolean
   - isPizzaComponent: boolean
   - isStockControlled: boolean
   - pizzaComponentTypeId: ComponentTypeId | null
   - allergenIds: AllergenId[]
   - pricingMode: PricingMode | null
   - basePrice: Money | null
   - isActive: boolean
   + getId(): ProductId
   + getName(): ProductName
   + getDescription(): ProductDescription
   + getCategoryId(): CategoryId
   + getAllergenIds(): AllergenId[]
   + getBasePrice(): Money | null
   + getPricingMode(): PricingMode | null
   + getPizzaComponentTypeId(): ComponentTypeId | null
   + isSellable(): boolean
   + isPizzaComponent(): boolean
   + isActive(): boolean
   + isStockControlled(): boolean
  }
  enum PricingMode {
   FIXED
   COMPONENT_BASED
  }
  class ProductId <<vo>> {
   - value: string
   {static} + create(value: string): ProductId
   + getValue(): string
  }
  class ProductName <<vo>> {
   - name: string
   + getValue(): string
  }
  class ProductDescription <<vo>> {
   - text: string
   + getValue(): string
  }
  class Money <<vo>> {
   - cents: int
   - currency: string
   {static} + create(amount: number, currency?: string): Money
   {static} + sum(values: Money[]): Money {proposed}
   + getAmount(): number
   + getCurrency(): string
   + equals(other: Money): boolean
  }
  class ProductCategory <<entity>> <<aggregateRoot>> {
   - id: CategoryId
   - name: CategoryName
   + getId(): CategoryId
   + getName(): CategoryName
  }
  class Allergen <<entity>> <<aggregateRoot>> {
   - id: AllergenId
   - name: AllergenName
   + getId(): AllergenId
   + getName(): AllergenName
  }
  class CategoryId <<vo>>
  class CategoryName <<vo>> {
   + getValue(): string
  }
  class AllergenId <<vo>>
  class AllergenName <<vo>> {
   + getValue(): string
  }
  class ComponentTypeId <<vo>>
  class PredefinedPizza <<entity>> <<aggregateRoot>> {
   - id: PredefinedPizzaId
   - productId: string
   - configuration: PizzaConfiguration
   + getId(): PredefinedPizzaId
   + getProductId(): string
   + getConfiguration(): PizzaConfiguration
  }
  class PredefinedPizzaId <<vo>> {
   + getValue(): string
  }
  class PizzaConfiguration <<vo>> {
   - componentIds: List<string>
   + getComponentIds(): string[]
  }
  class PizzaSize <<entity>> <<aggregateRoot>> {
   - id: PizzaSizeId
   - name: PizzaSizeName
   - active: boolean
   + getId(): PizzaSizeId
   + getName(): string
   + isActive(): boolean
  }
  class PizzaSizeId <<vo>> {
   - id: string
   + getValue(): string
  }
  class PizzaSizeName <<vo>> {
   - name: string
  }
  class ComponentSizeConfiguration <<entity>> <<aggregateRoot>> {
   - productId: ProductId
   - sizeId: PizzaSizeId
   - price: Money
   - consumption: StockUnitsConsumed | null
   + getPrice(): Money
   + getStockUnitsConsumed(): StockUnitsConsumed | null
  }
  class StockUnitsConsumed <<vo>> {
   - units: int
   + getUnits(): int
  }
  class StockInformation <<entity>> <<aggregateRoot>> {
   - productId: ProductId
   - quantity: AbstractStockQuantity
   - trackingStatus: TrackingStatus
   + getAvailableUnits(): int
   + getTrackingStatus(): TrackingStatus
   + isCurrent(): boolean
  }
  class AbstractStockQuantity <<vo>> {
   - availableUnits: int
  }
  enum TrackingStatus {
   CURRENT
   HISTORICAL
  }
 }
}
package "Infrastructure Layer" as INFRA {
 class PostgresCatalogueReader <<adapter>> {
