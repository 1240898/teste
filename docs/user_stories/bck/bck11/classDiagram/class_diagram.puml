 }
 class Database <<facade>> {
  + query(text: string, values: unknown[]): Promise<QueryResult>
 }

}
package "Composition Root" {
 class CatalogueModule <<factory>> {
  + createCatalogueModule(database: Database, accessHandlers: Middleware[]): Router
 }
}
