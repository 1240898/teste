@startuml sequence_diagram_adjust_stock
autonumber
skinparam shadowing true
skinparam responseMessageBelowArrow true

title Sequence Diagram - Adjust Current Stock

actor Manager
participant Routes as "StockRoutes"
participant Auth as "AuthMiddleware"
participant Roles as "RoleMiddleware"
participant Validator as "ValidationMiddleware"
participant Controller as "StockController"
participant Service as "StockManagementService"
participant UoW as "IUnitOfWork"
participant ProductReader as "IProductReader"
participant Repository as "IStockRepository"
participant Aggregate as "StockInformation"
participant Mapper as "StockResponseMapper"
database DB as "PostgreSQL"

Manager -> Routes : POST /api/v1/stock/{productId}/adjustments\n{ direction: DECREASE, units: 3 }
activate Routes
Routes -> Auth : verifyToken(req, res, next)
activate Auth
Auth --> Routes : identity established
deactivate Auth
Routes -> Roles : requireRole(MANAGER)
activate Roles
Roles --> Routes : authorized
deactivate Roles
Routes -> Validator : validate Product ID, direction and positive integer
activate Validator
Validator --> Routes : next()
deactivate Validator
Routes -> Controller : adjust(req, res)
activate Controller
Controller -> Service : adjustStock(productId, dto)
activate Service
Service -> UoW : withTransaction(work)
activate UoW
UoW -> DB : BEGIN
DB --> UoW : transaction started
UoW -> Service : execute work(tx)
Service -> ProductReader : getByIdForUpdate(productId, tx)
activate ProductReader
ProductReader -> DB : SELECT Product FOR UPDATE
DB --> ProductReader : Product status / none
ProductReader --> Service : ProductStockStatus / null
deactivate ProductReader

alt Product does not exist
    Service --> UoW : throw NotFound
    UoW -> DB : ROLLBACK
    DB --> UoW : rolled back
    UoW --> Service : rethrow error
    Service --> Controller : error
    Controller --> Manager : 404 Not Found
else Product exists
    Service -> Repository : findCurrentByProductIdForUpdate(productId, tx)
    activate Repository
    Repository -> DB : SELECT stock row WHERE ended_at IS NULL FOR UPDATE
    DB --> Repository : StockInformation / none
    Repository --> Service : current stock / null
    deactivate Repository
    alt Product has no current StockInformation
        Service --> UoW : throw NotFound
        UoW -> DB : ROLLBACK
        DB --> UoW : rolled back
        UoW --> Service : rethrow error
        Service --> Controller : error
        Controller --> Manager : 404 Not Found
    else Current stock exists
        Service -> Aggregate : decrease(3)
        activate Aggregate
        alt Available units are insufficient
            Aggregate --> Service : throw InsufficientStock
            Service --> UoW : throw Conflict
            UoW -> DB : ROLLBACK
            DB --> UoW : rolled back
            UoW --> Service : rethrow error
            Service --> Controller : error
            Controller --> Manager : 409 Conflict
        else Adjustment is valid
            Aggregate --> Service : updated quantity
            deactivate Aggregate
            Service -> Repository : save(stock, tx)
            activate Repository
            Repository -> DB : UPDATE stock_information SET available_units
            DB --> Repository : updated row
            Repository --> Service : saved
            deactivate Repository
            Service -> Mapper : toAdjustmentResult(stock, direction, units, productName)
            Mapper --> Service : StockAdjustmentResultDTO
            Service --> UoW : result
            UoW -> DB : COMMIT
            DB --> UoW : committed
            UoW --> Service : result
            Service --> Controller : result
            Controller --> Manager : 200 OK
        end
    end
end

deactivate UoW
deactivate Service
deactivate Controller
deactivate Routes

note over ProductReader,Aggregate
  Product active state does not prevent administrative
  stock adjustment. The Manager may adjust stock for an
  inactive Product. Product activation and stock quantity
  remain separate business concepts.
end note

note over Service,Aggregate
  Each adjustment must use a positive integer number of
  abstract units. A decrease cannot make availableUnits
  negative. A valid decrease to zero leaves the period open
  with endedAt empty; zero stock does not end tracking.
end note

@enduml
