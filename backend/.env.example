# HTTP port for the API (frontend expects 8080 by default)
PORT=8080

# Allowed CORS origin. Must match the frontend dev server origin.
CORS_ORIGIN=http://localhost:5173

# Node environment: development | test | production
NODE_ENV=development

# PostgreSQL: set your own local password (no committed credentials).
# PGSSLMODE=disable is for local development and the approved DEI-only database
# endpoint. Use verify-full only with a TLS-enabled PostgreSQL endpoint and its CA.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=laprizza
PGUSER=laprizza
PGPASSWORD=
PGSSLMODE=disable
PGPOOL_MAX=10
PGCONNECT_TIMEOUT_MS=5000
PGIDLE_TIMEOUT_MS=30000
PGSTATEMENT_TIMEOUT_MS=10000

# Required for API startup. Generate a random secret locally; never commit it.
# Example generator: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET= 
# Legacy JWT adapter setting; AA04 production token lifetime is ACCESS_TOKEN_TTL below.
JWT_EXPIRES_IN=5m
AUTH_IDLE_TIMEOUT_SECONDS=1800
ACTIVITY_REPORT_INTERVAL_SECONDS=60
ACCESS_TOKEN_TTL=5m
SESSION_RETENTION_SECONDS=604800
# Use false for local HTTP development only; production must use true.
SESSION_COOKIE_SECURE=false

# Password recovery: set SMTP values for email delivery.
# Local Mailpit: host 127.0.0.1, port 1025, secure=false, no SMTP credentials.
# Deployed Brevo: host smtp-relay.brevo.com, port 465, secure=true.
# Supply the Brevo SMTP login, SMTP key and verified sender through deployment secrets.
# Set PASSWORD_RECOVERY_WEB_URL to the public HTTPS frontend URL in deployed environments.
PASSWORD_RECOVERY_TOKEN_TTL_SECONDS=1800
PASSWORD_RECOVERY_WEB_URL=http://localhost:5173/
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional, one-time Admin bootstrap only. Remove real values after use.
BOOTSTRAP_ADMINISTRATOR_NAME=
BOOTSTRAP_ADMINISTRATOR_EMAIL=
BOOTSTRAP_ADMINISTRATOR_PASSWORD=


# AA02 - Google sign-in (OpenID Connect). Optional: leave all three empty to disable it.
# Create an OAuth client of type "Web application" in Google Cloud Console and register
# GOOGLE_REDIRECT_URI exactly. HTTPS is required outside localhost. Never commit the secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google

# WEB06 - public base URL of the kitchen model / texture files (back end only).
# The active kitchen configuration returns asset URLs built from it.
KITCHEN_ASSETS_PUBLIC_URL=http://localhost:8080/api/v1/kitchen-assets/files
